# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

.idea/
*.iml

# Built binaries
casbin-gateway
casbin-gateway-desktop

# Written next to the binaries at run time, so a second launch finds the tray
.desktop-instance

# Written next to the binaries at run time, for the window and the shortcuts
casbin-gateway.ico
casbin-gateway.icns
casbin-gateway.png

# Release and nightly archives, staged here by the workflows
dist/

tmp/
tmpFiles/
*.tmp
logs/
# Runtime state: the SQLite database, config snapshots and agent patch state
data/

# SQLite database and its WAL sidecar files
*.db
*.db-wal
*.db-shm

lastupdate.tmp
commentsRouter*.go
