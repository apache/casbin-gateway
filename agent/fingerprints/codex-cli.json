{
  "id": "codex-cli",
  "displayName": "Codex CLI",
  "installUrl": "https://developers.openai.com/codex/cli/",
  "execName": "codex",
  "instanceEnv": "CODEX_HOME",
  "stateDir": "codex",
  "npmPackage": "@openai/codex",
  "wingetPackage": "OpenAI.Codex",
  "windowsUserDirs": [
    "OpenAI/Codex/bin"
  ],
  "homebrewCasks": [
    "codex",
    "codex@latest"
  ],
  "updateArgs": [
    "update"
  ],
  "headless": {
    "args": [
      "exec",
      "--json",
      "--skip-git-repo-check",
      "-"
    ],
    "resumeArgs": [
      "exec",
      "resume",
      "--json",
      "--skip-git-repo-check",
      "{session}",
      "-"
    ],
    "modelArgs": [
      "--model",
      "{model}"
    ],
    "format": "codex-json",
    "promptStdin": true
  }
}
