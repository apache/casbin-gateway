{
  "id": "claude-code",
  "displayName": "Claude Code",
  "installUrl": "https://docs.claude.com/en/docs/claude-code/setup",
  "execName": "claude",
  "instanceEnv": "CLAUDE_CONFIG_DIR",
  "stateDir": "claude",
  "npmPackage": "@anthropic-ai/claude-code",
  "bundledDirs": [
    "Claude/claude-code/*"
  ],
  "wingetPackage": "Anthropic.ClaudeCode",
  "homebrewCasks": [
    "claude-code",
    "claude-code@latest"
  ],
  "systemPackage": "claude-code",
  "stateVersionGlob": "projects/*/*.jsonl",
  "updateArgs": [
    "update"
  ],
  "installScript": {
    "windows": "irm https://claude.ai/install.ps1 | iex",
    "darwin": "curl -fsSL https://claude.ai/install.sh | bash",
    "linux": "curl -fsSL https://claude.ai/install.sh | bash"
  },
  "headless": {
    "args": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--session-id",
      "{session}"
    ],
    "resumeArgs": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--resume",
      "{session}"
    ],
    "modelArgs": [
      "--model",
      "{model}"
    ],
    "format": "claude-stream-json",
    "promptStdin": true
  }
}
