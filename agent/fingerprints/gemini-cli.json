{
  "id": "gemini-cli",
  "displayName": "Gemini CLI",
  "installUrl": "https://google-gemini.github.io/gemini-cli/",
  "execName": "gemini",
  "stateDir": "gemini",
  "npmPackage": "@google/gemini-cli",
  "headless": {
    "args": [
      "-p",
      "",
      "-o",
      "text",
      "--session-id",
      "{session}"
    ],
    "modelArgs": [
      "-m",
      "{model}"
    ],
    "format": "text",
    "promptStdin": true
  }
}
