{
  "id": "codebuddy",
  "displayName": "CodeBuddy Code",
  "installUrl": "https://www.codebuddy.ai/docs/cli/installation",
  "execName": "codebuddy",
  "instanceEnv": "CODEBUDDY_CONFIG_DIR",
  "stateDir": "codebuddy",
  "npmPackage": "@tencent-ai/codebuddy-code",
  "headless": {
    "args": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--session-id",
      "{session}"
    ],
    "resumeArgs": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--resume",
      "{session}"
    ],
    "modelArgs": [
      "--model",
      "{model}"
    ],
    "format": "claude-stream-json",
    "promptStdin": true
  }
}
