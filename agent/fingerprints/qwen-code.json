{
  "id": "qwen-code",
  "displayName": "Qwen Code",
  "installUrl": "https://github.com/QwenLM/qwen-code",
  "execName": "qwen",
  "stateDir": "qwen",
  "npmPackage": "@qwen-code/qwen-code",
  "headless": {
    "args": [
      "-p",
      "",
      "-o",
      "text",
      "--session-id",
      "{session}"
    ],
    "resumeArgs": [
      "-p",
      "",
      "-o",
      "text",
      "--resume",
      "{session}"
    ],
    "modelArgs": [
      "-m",
      "{model}"
    ],
    "format": "text",
    "promptStdin": true
  }
}
