{
  "id": "firecrawl",
  "displayName": "Firecrawl",
  "category": "dev",
  "icon": "firecrawl.dev",
  "description": "Scrapes and crawls websites into clean text the model can read, including pages that only render once their scripts have run.",
  "docsUrl": "https://github.com/firecrawl/firecrawl-mcp-server",
  "auth": {
    "kind": "token",
    "fields": [
      {
        "key": "apiKey",
        "label": "API key",
        "placeholder": "fc-...",
        "help": "From the Firecrawl dashboard.",
        "secret": true,
        "required": true
      }
    ],
    "registerUrl": "https://www.firecrawl.dev/app/api-keys"
  },
  "server": {
    "name": "firecrawl",
    "transport": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "firecrawl-mcp"
    ],
    "env": {
      "FIRECRAWL_API_KEY": "${apiKey}"
    }
  }
}
