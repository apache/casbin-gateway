{
  "id": "baidu-map",
  "displayName": "Baidu Maps",
  "category": "life",
  "icon": "map.baidu.com",
  "description": "Search places, plan routes, check the weather and turn an address into coordinates, over Baidu's map data.",
  "docsUrl": "https://lbsyun.baidu.com/faq/api?title=mcpserver/base",
  "auth": {
    "kind": "token",
    "fields": [
      {
        "key": "apiKey",
        "label": "Server-side AK",
        "help": "From the Baidu Maps open platform. Create a server-side key, not a browser one.",
        "secret": true,
        "required": true
      }
    ],
    "registerUrl": "https://lbsyun.baidu.com/apiconsole/key"
  },
  "server": {
    "name": "baidu-map",
    "transport": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@baidumap/mcp-server-baidu-map"
    ],
    "env": {
      "BAIDU_MAP_API_KEY": "${apiKey}"
    }
  }
}
