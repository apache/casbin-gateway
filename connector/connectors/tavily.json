{
  "id": "tavily",
  "displayName": "Tavily",
  "category": "dev",
  "icon": "tavily.com",
  "description": "Web search built for models rather than people: a question goes in, sourced answers come back instead of a page of links.",
  "docsUrl": "https://github.com/tavily-ai/tavily-mcp",
  "auth": {
    "kind": "token",
    "fields": [
      {
        "key": "apiKey",
        "label": "API key",
        "placeholder": "tvly-...",
        "help": "From the Tavily dashboard.",
        "secret": true,
        "required": true
      }
    ],
    "registerUrl": "https://app.tavily.com/home"
  },
  "server": {
    "name": "tavily",
    "transport": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "tavily-mcp@latest"
    ],
    "env": {
      "TAVILY_API_KEY": "${apiKey}"
    }
  }
}
