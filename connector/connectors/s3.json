{
  "id": "s3",
  "displayName": "Object storage",
  "category": "storage",
  "icon": "min.io",
  "description": "Lists buckets, reads and writes objects on anything that speaks S3: AWS, Aliyun OSS, Tencent COS, Cloudflare R2, Backblaze B2 and MinIO.",
  "docsUrl": "https://github.com/samuraikun/s3-mcp-server",
  "auth": {
    "kind": "token",
    "fields": [
      {
        "key": "endpoint",
        "label": "Endpoint",
        "placeholder": "https://oss-cn-hangzhou.aliyuncs.com",
        "help": "The service's own address. For AWS itself, the regional S3 endpoint.",
        "required": true
      },
      {
        "key": "region",
        "label": "Region",
        "placeholder": "auto",
        "required": true
      },
      {
        "key": "accessKeyId",
        "label": "Access key ID",
        "secret": true,
        "required": true
      },
      {
        "key": "secretAccessKey",
        "label": "Secret access key",
        "secret": true,
        "required": true
      }
    ]
  },
  "server": {
    "name": "s3",
    "transport": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "s3-mcp-server"
    ],
    "env": {
      "S3_ENDPOINT": "${endpoint}",
      "S3_REGION": "${region}",
      "S3_ACCESS_KEY_ID": "${accessKeyId}",
      "S3_SECRET_ACCESS_KEY": "${secretAccessKey}"
    }
  }
}
